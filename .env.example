# Required
DATABASE_URL=postgres://user:password@localhost:5432/ravpaper
# At least 32 characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional
PORT=5000
TRUST_PROXY=
COOKIE_SECURE=
ANALYSIS_WORKER=
ANALYSIS_CONCURRENCY=2

# Billing (all required to enable checkout)
APP_BASE_URL=http://localhost:5000
STRIPE_ACCOUNT_ID=acct_...
STRIPE_MODE=test
# Printed by `npx tsx server/seedProducts.ts`
STRIPE_CREDIT_PRICES=price_...:prod_...:1,price_...:prod_...:5
# Outside Replit only
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_CHARGING_ENABLED=false
STRIPE_DEV_PROVISION=
